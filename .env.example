# Copie para .env:  cp .env.example .env
# NUNCA versione o arquivo .env

# --- Airflow ---
# No Linux, use o seu UID (comando: id -u). No Windows/Mac pode deixar 50000.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=troque-esta-chave

# --- Armazenamento do data lake ---
# local = grava em ./data/lake (bom para começar sem GCP)
# gcs   = grava no bucket abaixo (precisa de credentials/gcp-sa.json)
STORAGE_BACKEND=local
GCS_BUCKET=seu-bucket-editais

# --- BigQuery (Sandbox funciona: não precisa de faturamento) ---
# Deixe GCP_PROJECT_ID vazio para pular a carga no BigQuery.
GCP_PROJECT_ID=
BQ_DATASET_BRONZE=editais_bronze
BQ_LOCATION=US

# --- pgvector (Fase 4) ---
# Fora do Docker (scripts no seu PC) o banco fica em localhost:5433; dentro do compose, pgvector:5432.
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5433
PGVECTOR_USER=editais
PGVECTOR_PASSWORD=editais
PGVECTOR_DB=editais

# --- OpenAI (Fase 2) ---
OPENAI_API_KEY=

# Modelo usado na extração (silver). Barato e bom com tabelas.
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini

# --- RAG / Text-to-SQL (Fase 4) ---
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BQ_DATASET_GOLD=editais_gold
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=80

# --- API / chat (Fases 6 e 7) ---
API_KEY=                 # vazio = sem autenticação (só para uso local!)
DAILY_BUDGET_USD=1.00    # trava: a API recusa perguntas após gastar isso no dia
RATE_LIMIT_PER_MIN=20
