# Fase 6: API (FastAPI) + servidor MCP. Imagem enxuta, sem Airflow.
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
COPY requirements-rag.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-rag.txt -r requirements-api.txt
COPY src/ src/
EXPOSE 8000 8001
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')"
CMD ["uvicorn", "editais.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
